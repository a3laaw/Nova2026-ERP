
{
  "entities": {
    "Account": {
      "title": "Accounting Account",
      "description": "عنصر في دليل الحسابات (شجرة الحسابات).",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "type": { "type": "string", "enum": ["asset", "liability", "equity", "revenue", "expense"] },
        "parentId": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "level": { "type": "number" },
        "companyId": { "type": "string" }
      },
      "required": ["code", "nameAr", "type", "isGroup", "companyId"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "قيد محاسبي مزدوج القيمة.",
      "type": "object",
      "properties": {
        "entryNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "posted", "reversed"] },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accountId": { "type": "string" },
              "accountName": { "type": "string" },
              "debit": { "type": "number" },
              "credit": { "type": "number" },
              "projectId": { "type": "string" },
              "costCenterId": { "type": "string" },
              "memo": { "type": "string" }
            }
          }
        },
        "companyId": { "type": "string" }
      }
    },
    "Voucher": {
      "title": "Accounting Voucher",
      "description": "سند مالي (قبض أو صرف).",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["receipt", "payment"] },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "personName": { "type": "string" },
        "accountId": { "type": "string" },
        "journalEntryId": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/companies/{companyId}/accounts/{accountId}": { "schema": "#/entities/Account", "description": "دليل الحسابات" },
    "/companies/{companyId}/journalEntries/{entryId}": { "schema": "#/entities/JournalEntry", "description": "قيود اليومية" },
    "/companies/{companyId}/vouchers/{voucherId}": { "schema": "#/entities/Voucher", "description": "سندات القبض والصرف" }
  }
}
