rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. المساعدات السيادية (Sovereign Helpers) ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // المفتاح الرئيسي للمطور (Absolute Master Key)
    function isSovereignDev() {
      return isAuthenticated() && request.auth.token.email == 'admin@novaflow.com';
    }

    // جلب بيانات الهوية العالمية بشكل آمن
    function currentUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // التحقق من دور الأدمن (Sovereign Authority Lock)
    // تم التحديث ليكون "محصناً ضد الخطأ" ويدعم كافة حالات الأحرف
    function isGlobalAdmin() {
      return isAuthenticated() && (
        isSovereignDev() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         (currentUserData().get('roleCode', 'USER').upper() == 'ADMIN' || 
          currentUserData().get('role', 'user').upper() == 'ADMIN'))
      );
    }

    function getUserCompany() {
      return currentUserData().companyId;
    }

    // التحقق من التبعية للمنشأة
    function belongsToCompany(companyId) {
      return isAuthenticated() && (isGlobalAdmin() || getUserCompany() == companyId);
    }

    // --- 2. قواعد الهوية العالمية (global_users) ---
    
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isGlobalAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == uid || isGlobalAdmin());
      allow write: if isSovereignDev();
    }

    // --- 3. قواعد المنشآت (Multi-Tenant Core) ---
    
    match /companies/{companyId} {
      allow read: if belongsToCompany(companyId);
      allow create: if isSovereignDev();
      allow update: if isGlobalAdmin() && getUserCompany() == companyId;
      allow delete: if isSovereignDev();

      match /{allSubCollections=**} {
        allow read, write: if belongsToCompany(companyId);
      }
    }

    // --- 4. قواعد الاستعلامات المشتركة (Collection Group Rules) ---
    // تحصين شامل لكافة مجموعات البيانات لضمان عدم ظهور أخطاء الصلاحيات للأدمن
    
    match /{path=**}/stages/{stageId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read, write: if belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/executions/{execId} {
      allow read, write: if belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/jobs/{jobId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/attendance/{recordId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/variations/{voId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }
    
    match /{path=**}/contracts/{docId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }
    
    match /{path=**}/quotations/{docId} {
      allow read: if belongsToCompany(resource.data.companyId);
    }

    // --- 5. طلبات التأسيس ---
    
    match /company_requests/{reqId} {
      allow create: if true; 
      allow read, write: if isGlobalAdmin();
    }
  }
}