
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    // المطور الرسمي يتجاوز كافة القيود فوراً لضمان عمل بوابة الرقابة ومنع أخطاء collectionGroup
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // دالة جلب البيانات العالمية للمستخدم مع فحص الوجود لمنع انهيار القاعدة
    function getUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    function hasGlobalData() {
      return exists(/databases/$(database)/documents/global_users/$(request.auth.uid));
    }

    // --- 3. قواعد الهوية العالمية (Global Identity) ---
    match /global_users/{uid} {
      // السماح للمستخدم دائماً بقراءة وإنشاء ملفه الشخصي لضمان استقرار جلسة التسجيل
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && request.auth.uid == uid;
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      
      // فك العقدة: السماح دائماً بقراءة بيانات المنشأة الأساسية (الاسم، الحالة) 
      // لتمكين النظام من فحص الحالة وعرض شاشة "بانتظار التفعيل" بدلاً من إظهار خطأ صلاحيات
      allow read: if isAuthenticated(); 

      // قواعد المستخدمين داخل المنشأة
      match /users/{uid} {
        // السماح بإنشاء الحساب الأول في المنشأة أثناء التسجيل
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow read: if isAuthenticated();
        allow update: if isAuthenticated() && request.auth.uid == uid;
      }

      // حماية المجموعات الفرعية التشغيلية (البيانات الحساسة)
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && 
          hasGlobalData() &&
          getUserData().companyId == companyId && 
          (getUserData().isActive == true || isSovereignDev());
          
        allow write: if isAuthenticated() && 
          hasGlobalData() &&
          getUserData().companyId == companyId && 
          (getUserData().roleCode == 'ADMIN' || isSovereignDev());
      }
    }

    // --- 5. طلبات الانضمام ---
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }

    // --- 6. حماية المجموعات المشتركة (Collection Group Rules) ---
    // القواعد المسطحة لضمان عمل استعلامات المجموعات دون الحاجة لـ get() معقد
    match /{path=**}/variations/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/fieldVisits/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/attendance/{id} { allow read: if isAuthenticated(); }
  }
}
