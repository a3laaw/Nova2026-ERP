
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال المساعدة السيادية ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // التحقق مما إذا كان المستخدم هو المطور العالمي المبرمج
    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@novaflow.com' ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.isDeveloper == true)
      );
    }

    function getGlobalData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         getGlobalData().companyId == companyId)
      );
    }

    function isAdmin(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         getGlobalData().companyId == companyId && 
         (getGlobalData().role == 'admin' || getGlobalData().role == 'Admin' || getGlobalData().roleCode == 'ADMIN'))
      );
    }

    // --- سجلات المستخدمين العالمية (Identity) ---
    
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isDeveloper());
      allow list: if isDeveloper();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isDeveloper() || (isAuthenticated() && request.auth.uid == uid);
      allow delete: if isDeveloper();
    }
    
    match /company_requests/{reqId} {
       allow create: if true; 
       allow read, write: if isDeveloper();
    }

    // --- سجلات المنشأة (Multi-tenant) ---
    
    match /companies/{companyId} {
      allow read, list: if belongsToCompany(companyId) || isDeveloper();
      allow create: if isAuthenticated(); 
      allow update: if isAdmin(companyId) || isDeveloper();
      allow delete: if isDeveloper();
      
      match /users/{uid} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow create, update: if isAuthenticated() && (request.auth.uid == uid || isAdmin(companyId));
        allow delete: if isAdmin(companyId) || isDeveloper();
      }

      match /employees/{empId} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow write: if isAdmin(companyId) || isDeveloper();
      }

      match /{allSubCollections=**} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow write: if isAdmin(companyId) || isDeveloper();
      }
    }

    // دعم استعلامات الـ Collection Group للأوامر التغييرية والزيارات
    match /{path=**}/variations/{voId} {
      allow read: if isAuthenticated() && (isDeveloper() || belongsToCompany(resource.data.companyId));
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isAuthenticated() && (isDeveloper() || belongsToCompany(resource.data.companyId));
    }
  }
}
