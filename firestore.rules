rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    function hasGlobalData() {
      return exists(/databases/$(database)/documents/global_users/$(request.auth.uid));
    }

    // فحص الانتساب والنشاط (The Activity Guard)
    function isActiveUser(companyId) {
      return isAuthenticated() && 
             hasGlobalData() && 
             getUserData().companyId == companyId && 
             getUserData().isActive == true;
    }

    // فحص الصلاحية الإدارية
    function isAdmin(companyId) {
      return isActiveUser(companyId) && getUserData().roleCode == 'ADMIN';
    }

    // --- 3. قواعد الهوية العالمية (Global Identity) ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && request.auth.uid == uid;
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated(); 

      // أ. العمليات التشغيلية (متاحة لكافة الموظفين النشطين)
      // تشمل المواعيد، الزيارات، التايم لاين، والتعليقات
      match /appointments/{id} { allow read, write: if isActiveUser(companyId); }
      match /leaveRequests/{id} { allow read, write: if isActiveUser(companyId); }
      match /permissionRequests/{id} { allow read, write: if isActiveUser(companyId); }
      match /executions/{id} { allow read, write: if isActiveUser(companyId); }
      
      match /transactions/{tId}/fieldVisits/{id} { allow read, write: if isActiveUser(companyId); }
      match /transactions/{tId}/timeline/{id} { allow read, write: if isActiveUser(companyId); }
      match /transactions/{tId}/comments/{id} { allow read, write: if isActiveUser(companyId); }
      match /transactions/{tId}/stageInstances/{id} { allow read, write: if isActiveUser(companyId); }

      // ب. البيانات الحساسة والإعدادات (للمدراء فقط)
      match /users/{uid} {
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow read: if isActiveUser(companyId);
        allow update: if isAdmin(companyId) || (isAuthenticated() && request.auth.uid == uid);
      }

      match /{allAdminCollections=**} {
        allow read: if isActiveUser(companyId);
        allow write: if isAdmin(companyId);
      }
    }

    // --- 5. طلبات الانضمام ---
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }

    // --- 6. حماية المجموعات المشتركة (Collection Group Rules) ---
    match /{path=**}/variations/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/fieldVisits/{id} { allow read: if isAuthenticated(); }
    match /{path=**}/attendance/{id} { allow read: if isAuthenticated(); }
  }
}