rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // السماح الشامل للمطور (Bypass)
    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة (Sovereign Helpers) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // جلب بيانات الهوية العالمية
    function getGlobalUser() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // فحص صلاحية الإدارة (المبسط لضمان السرعة)
    function isAdmin() {
      let user = getGlobalUser();
      return isAuthenticated() && (user.roleCode == 'ADMIN' || user.role == 'admin' || isSovereignDev());
    }

    // --- 3. قواعد الهوية العالمية ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
    }
    
    // --- 4. قواعد المجموعات الفرعية (Collection Groups) ---
    // ضروري لعمليات البحث الشامل والتقارير الموحدة
    match /{path=**}/jobs/{jobId} {
      allow read: if isAuthenticated() && (getGlobalUser().companyId == resource.data.companyId || isSovereignDev());
    }
    
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isAuthenticated() && (getGlobalUser().companyId == resource.data.companyId || isSovereignDev());
    }

    // --- 5. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (getGlobalUser().companyId == companyId || isSovereignDev());
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isSovereignDev());

      // القاعدة الذهبية للمجموعات الفرعية التابعة للشركة
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && (getGlobalUser().companyId == companyId || isSovereignDev());
        allow write: if isAuthenticated() && (
           getGlobalUser().companyId == companyId && 
           (getGlobalUser().roleCode == 'ADMIN' || getGlobalUser().role == 'admin')
        );
      }
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }
  }
}