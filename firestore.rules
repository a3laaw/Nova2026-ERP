
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال المساعدة السيادية المحدثة للسرعة والأمان ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // التحقق من هوية المطور (Fast Path)
    // نستخدم الإيميل المباشر كأسرع وسيلة للتحقق لضمان عمل استعلامات الـ Collection Group
    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@novaflow.com' ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.isDeveloper == true)
      );
    }

    // التحقق من انتساب الموظف للمنشأة (عزل البيانات)
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId)
      );
    }

    // التحقق من الصلاحيات الإدارية داخل المنشأة
    function isAdmin(companyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId && 
         (get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN' || 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // --- سجلات المستخدمين العالمية (Identity) ---
    
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || request.auth.token.email == 'admin@novaflow.com');
      allow list: if request.auth.token.email == 'admin@novaflow.com';
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if request.auth.token.email == 'admin@novaflow.com' || (isAuthenticated() && request.auth.uid == uid);
      allow delete: if request.auth.token.email == 'admin@novaflow.com';
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, list, write: if request.auth.token.email == 'admin@novaflow.com';
    }

    // --- سجلات المنشأة (Multi-tenant) ---
    
    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if request.auth.token.email == 'admin@novaflow.com' || belongsToCompany(companyId);
      allow update: if request.auth.token.email == 'admin@novaflow.com' || isAdmin(companyId);
      allow delete: if request.auth.token.email == 'admin@novaflow.com';
      
      match /users/{uid} {
        allow read: if belongsToCompany(companyId) || request.auth.token.email == 'admin@novaflow.com';
        allow create, update: if isAuthenticated() && (request.auth.uid == uid || isAdmin(companyId) || request.auth.token.email == 'admin@novaflow.com');
        allow delete: if isAdmin(companyId) || request.auth.token.email == 'admin@novaflow.com';
      }

      match /employees/{empId} {
        allow read: if belongsToCompany(companyId) || request.auth.token.email == 'admin@novaflow.com';
        allow write: if isAdmin(companyId) || request.auth.token.email == 'admin@novaflow.com';
      }

      match /{allSubCollections=**} {
        allow read: if belongsToCompany(companyId) || request.auth.token.email == 'admin@novaflow.com';
        allow write: if isAdmin(companyId) || request.auth.token.email == 'admin@novaflow.com';
      }
    }

    // دعم استعلامات الـ Collection Group (المعدلة للسرعة)
    match /{path=**}/variations/{voId} {
      allow read, list: if isAuthenticated() && (request.auth.token.email == 'admin@novaflow.com' || (resource != null && belongsToCompany(resource.data.companyId)));
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read, list: if isAuthenticated() && (request.auth.token.email == 'admin@novaflow.com' || (resource != null && belongsToCompany(resource.data.companyId)));
    }
  }
}
