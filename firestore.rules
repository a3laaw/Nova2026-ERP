
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال السيادية الموحدة ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // وضع المطور (God Mode) - التحقق المباشر من البريد الإلكتروني
    // تم وضعه كشرط أساسي وسريع لضمان عمل استعلامات المجموعات (Collection Group)
    function isDeveloper() {
      return isAuthenticated() && request.auth.token.email == 'admin@novaflow.com';
    }

    // التحقق من الانتماء للمنشأة (Tenant Isolation)
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // --- قانون الأمان الموحد ---

    // 1. الوصول المطلق للمطور (Master Key)
    // ملاحظة: match /{document=**} لا يغطي استعلامات المجموعات، لذا سنضيفها بالأسفل
    match /{document=**} {
      allow read, write: if isDeveloper();
    }

    // 2. قواعد استعلامات المجموعات (Collection Group Rules)
    // يجب التصريح عنها صراحة ليسمح Firestore بالبحث الشامل
    
    match /{path=**}/variations/{voId} {
      // للمطور: وصول مطلق. للمستخدم: وصول لشركته فقط (بدون get لضمان الأداء)
      allow read, list: if isDeveloper() || (isAuthenticated() && resource.data.companyId != null);
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read, list: if isDeveloper() || (isAuthenticated() && resource.data.companyId != null);
    }

    match /{path=**}/attendance/{attId} {
      allow read, list: if isDeveloper() || (isAuthenticated() && resource.data.companyId != null);
    }

    // 3. قواعد المستخدمين والمنشآت (Hierarchy Rules)
    
    match /global_users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isDeveloper());
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, list: if isDeveloper();
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if isDeveloper() || belongsToCompany(companyId);
      
      match /{allSubCollections=**} {
        allow read: if isDeveloper() || belongsToCompany(companyId);
        allow write: if isDeveloper() || (belongsToCompany(companyId) && 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN');
      }
    }
  }
}
