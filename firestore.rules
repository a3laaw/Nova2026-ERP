rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة (Sovereign Helpers) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getGlobalUser() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId);
    }

    function isAdmin(companyId) {
      let hasGlobalUser = exists(/databases/$(database)/documents/global_users/$(request.auth.uid));
      let globalUser = hasGlobalUser ? get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data : null;
      let company = exists(/databases/$(database)/documents/companies/$(companyId)) ? get(/databases/$(database)/documents/companies/$(companyId)).data : null;
      
      return isAuthenticated() && (
        // مسار الصلاحيات المكتوبة: يتطلب الآن أن يكون الحساب نشطاً (isActive == true)
        (globalUser != null && globalUser.companyId == companyId && globalUser.isActive == true && (globalUser.roleCode == 'ADMIN' || globalUser.role == 'admin')) ||
        // مسار الملكية المطلقة (Sovereign Owner): المالك المسجل في الشركة دائماً أدمن عليها
        (company != null && company.ownerUid == request.auth.uid) ||
        // مسار المطور العالمي
        (globalUser != null && globalUser.isDeveloper == true)
      );
    }

    // --- 3. قواعد الهوية العالمية (Global Identity) ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin(resource.data.companyId));
      
      // تحصين الإنشاء: منع تصعيد الصلاحيات (Privilege Escalation)
      allow create: if isAuthenticated() && (
        // مسار المستخدم يسجل نفسه: ممنوع من تحديد أي صلاحيات حساسة
        (request.auth.uid == uid && !request.resource.data.keys().hasAny(['isDeveloper', 'roleCode', 'role'])) || 
        // مسار الأدمن يضيف موظف: مسموح له تحديد الصلاحيات للموظف الجديد
        isAdmin(request.resource.data.companyId)
      );
      
      // منع تغيير الحقول الحساسة (بما فيها isActive) إلا من خلال الأدمن أو المطور
      allow update: if isAuthenticated() && (
        // المستخدم يعدل ملفه: ممنوع يغير دوره أو يفعل حسابه بنفسه
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeveloper', 'roleCode', 'role', 'companyId', 'isActive'])) || 
        // الأدمن أو المطور يعدل: مسموح لهم كامل الصلاحية للتفعيل والترفيع
        isAdmin(resource.data.companyId) || 
        isSovereignDev()
      );
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      // القراءة فقط لأعضاء الشركة أو الأدمن لضمان الخصوصية (belongsToCompany تحمي البيانات)
      allow read: if belongsToCompany(companyId) || isAdmin(companyId); 
      
      // التحقق من أن منشئ الشركة هو المالك الفعلي المسجل لضمان سلامة الهوية
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid; 
      
      allow update: if isAdmin(companyId);

      match /counters/{id} {
        allow read, write: if isAdmin(companyId);
      }

      match /appointments/{id} { 
        allow read: if belongsToCompany(companyId); 
        allow write: if isAdmin(companyId); 
      }
      
      match /leaveRequests/{id} { allow read, write: if belongsToCompany(companyId); }
      match /permissionRequests/{id} { allow read, write: if belongsToCompany(companyId); }
      match /executions/{id} { allow read, write: if belongsToCompany(companyId); }
      
      match /transactions/{tId}/fieldVisits/{id} { allow read, write: if belongsToCompany(companyId); }
      match /transactions/{tId}/timeline/{id} { allow read, write: if belongsToCompany(companyId); }
      match /transactions/{tId}/comments/{id} { allow read, write: if belongsToCompany(companyId); }
      match /transactions/{tId}/stageInstances/{id} { allow read, write: if belongsToCompany(companyId); }

      match /users/{uid} {
        allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin(companyId));
        allow read: if belongsToCompany(companyId);
        allow update: if isAdmin(companyId) || (isAuthenticated() && request.auth.uid == uid);
      }

      match /{allAdminCollections=**} {
        allow read: if belongsToCompany(companyId);
        allow write: if isAdmin(companyId);
      }
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }

    match /{path=**}/variations/{id} { allow read: if belongsToCompany(resource.data.companyId); }
    match /{path=**}/fieldVisits/{id} { allow read: if belongsToCompany(resource.data.companyId); }
    match /{path=**}/attendance/{id} { allow read: if belongsToCompany(resource.data.companyId); }
  }
}