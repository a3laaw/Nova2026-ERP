
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال المساعدة المطورة ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@novaflow.com' ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         getUserData().isDeveloper == true)
      );
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         getUserData().companyId == companyId)
      );
    }

    function isAdmin(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         getUserData().companyId == companyId && 
         (getUserData().role == 'admin' || getUserData().role == 'Admin' || getUserData().roleCode == 'ADMIN'))
      );
    }

    // --- سجلات المستخدمين العالمية ---
    
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isDeveloper() || isAdmin(get(/databases/$(database)/documents/global_users/$(uid)).data.companyId));
      allow create, update: if isDeveloper() || (isAuthenticated() && request.auth.uid == uid) || (isAuthenticated() && isAdmin(request.resource.data.companyId));
      allow delete: if isDeveloper();
    }
    
    match /company_requests/{reqId} {
       allow create: if true;
       allow read, write: if isDeveloper();
    }

    // --- سجلات المنشأة (Multi-tenant) ---
    
    match /companies/{companyId} {
      allow read: if belongsToCompany(companyId);
      
      // قواعد مستخدمي الشركة (Authentication metadata)
      // السماح للموظف بتحديث بيانات دخوله وصورته الشخصية في سجل الشركة
      match /users/{uid} {
        allow read: if belongsToCompany(companyId);
        allow update: if isAdmin(companyId) || (isAuthenticated() && request.auth.uid == uid);
        allow create, delete: if isAdmin(companyId);
      }

      // قواعد الموظفين (رؤية الجميع وتعديل النفس للمدير)
      match /employees/{empId} {
        allow read: if belongsToCompany(companyId);
        allow create, delete: if isAdmin(companyId);
        allow update: if isAdmin(companyId) || (isAuthenticated() && getUserData().employeeId == empId);
      }

      // قواعد العملاء (المهندسون يحتاجون لإضافة عملاء جدد ميدانياً)
      match /clients/{clientId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update, delete: if isAdmin(companyId);
        
        match /history/{histId} {
          allow read: if belongsToCompany(companyId);
          allow create: if belongsToCompany(companyId);
        }
      }

      // قواعد المواعيد (تنسيق المواعيد الميدانية والذاتية)
      match /appointments/{apptId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update, delete: if isAdmin(companyId) || (isAuthenticated() && (resource.data.createdBy == request.auth.uid || request.resource.data.createdBy == request.auth.uid));
      }

      // قواعد الإجازات والاستئذانات (خدمة ذاتية + صلاحيات إدارية للغير)
      match /leaveRequests/{reqId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && (request.resource.data.userId == request.auth.uid || isAdmin(companyId));
        allow update, delete: if isAdmin(companyId);
      }

      match /permissionRequests/{reqId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && (request.resource.data.userId == request.auth.uid || isAdmin(companyId));
        allow update, delete: if isAdmin(companyId);
      }

      // قواعد المشاريع والتنفيذ (للمهندسين)
      match /transactions/{transId} {
        allow read: if belongsToCompany(companyId);
        allow write: if isAdmin(companyId);

        match /stageInstances/{instId} {
          allow read: if belongsToCompany(companyId);
          allow write: if belongsToCompany(companyId); 
        }
        match /timeline/{logId} {
          allow read: if belongsToCompany(companyId);
          allow create: if belongsToCompany(companyId);
        }
        match /comments/{commentId} {
          allow read: if belongsToCompany(companyId);
          allow create: if belongsToCompany(companyId);
          allow update, delete: if isAdmin(companyId) || (isAuthenticated() && request.auth.uid == resource.data.createdBy);
        }
      }

      match /executions/{execId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId); 
      }

      // باقي المجموعات محصورة للمدير
      match /{allSubCollections=**} {
        allow read: if belongsToCompany(companyId);
        allow write: if isAdmin(companyId);
      }
    }
  }
}
