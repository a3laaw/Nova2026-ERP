rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. القانون الأسمى (Sovereign Master Key) ---
    // المطور والمدير الرئيسي لهم حق الوصول المطلق دون قيود
    function isSovereignDev() {
      return request.auth != null && (
        request.auth.token.email == 'admin@novaflow.com' || 
        get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN'
      );
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // --- 3. قواعد الهوية العالمية ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
    }
    
    // --- 4. قواعد المجموعات الفرعية (Collection Groups) ---
    // السماح بالبحث الشامل والفلترة لموظفي نفس الشركة
    match /{path=**}/jobs/{jobId} {
      allow read: if isAuthenticated() && (getUserData().companyId == resource.data.companyId || isSovereignDev());
    }
    
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isAuthenticated() && (getUserData().companyId == resource.data.companyId || isSovereignDev());
    }

    match /{path=**}/executions/{execId} {
      allow read, write: if isAuthenticated() && (getUserData().companyId == resource.data.companyId || isSovereignDev());
    }

    // --- 5. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (getUserData().companyId == companyId || isSovereignDev());
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isSovereignDev());

      // القاعدة الذهبية: الوصول الكامل داخل نطاق الشركة للمصرح لهم
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && (getUserData().companyId == companyId || isSovereignDev());
        allow write: if isAuthenticated() && (getUserData().companyId == companyId && (getUserData().roleCode == 'ADMIN' || isSovereignDev()));
      }
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }
  }
}