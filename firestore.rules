
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- قانون الأمان الأسمى (Sovereign God Mode) ---
    // منح المطور وصولاً مطلقاً ومباشراً يتجاوز كافة القيود لضمان عمل الرقابة والتقارير
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // السماح للمطور بالوصول الشامل لكافة المستندات
    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- حماية المجموعات المشتركة (Collection Group Rules) ---
    // ضرورية لعمل الفهارس (Indexes) - يسمح بالقراءة للمستخدمين المسجلين لضمان عمل التقارير
    match /{path=**}/variations/{voId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/attendance/{attId} {
      allow read: if request.auth != null;
    }

    // --- الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // فحص وجود المستند قبل محاولة قراءته لتجنب أخطاء الصلاحيات الوهمية
    function getGlobalUser() {
      let userPath = /databases/$(database)/documents/global_users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }

    function isCompanyActive(cid) {
      let compPath = /databases/$(database)/documents/companies/$(cid);
      return exists(compPath) && get(compPath).data.status == 'active';
    }

    function isNotPending(uid) {
      let userPath = /databases/$(database)/documents/global_users/$(uid);
      return exists(userPath) && get(userPath).data.isPendingApproval != true;
    }

    // --- قواعد الهوية والمنشآت (Multi-Tenant Isolation) ---
    match /global_users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid);
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, delete: if isSovereignDev();
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (isSovereignDev() || (getGlobalUser() != null && getGlobalUser().companyId == companyId));
      
      match /{allSubCollections=**} {
        // قفل أمني صارم للمستخدمين العاديين
        allow read: if isAuthenticated() && 
          getGlobalUser() != null &&
          getGlobalUser().companyId == companyId && 
          getGlobalUser().isActive == true && 
          isNotPending(request.auth.uid) &&
          isCompanyActive(companyId);
          
        allow write: if isAuthenticated() && 
          getGlobalUser() != null &&
          getGlobalUser().companyId == companyId && 
          getGlobalUser().isActive == true && 
          isNotPending(request.auth.uid) &&
          isCompanyActive(companyId) &&
          (getGlobalUser().roleCode == 'ADMIN' || getGlobalUser().role == 'admin');
      }
    }
  }
}
