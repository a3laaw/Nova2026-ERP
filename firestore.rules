
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال السيادية الموحدة ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // وضع المطور (God Mode) - التحقق الصارم والمباشر من البريد
    function isDeveloper() {
      return isAuthenticated() && request.auth.token.email == 'admin@novaflow.com';
    }

    // --- قانون الأمان الموحد ---

    // 1. الوصول المطلق للمطور (Master Key)
    // يُطبق على كافة المستندات بما في ذلك استعلامات المجموعات
    match /{document=**} {
      allow read, write: if isDeveloper();
    }

    // 2. قواعد استعلامات المجموعات (Collection Group Rules)
    // ضرورية لعمل التقارير الشاملة والبحث الموحد عبر المنشآت
    
    match /{path=**}/variations/{voId} {
      allow read: if isDeveloper() || (isAuthenticated() && resource.data.companyId == get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId);
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isDeveloper() || (isAuthenticated() && resource.data.companyId == get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId);
    }

    match /{path=**}/attendance/{attId} {
      allow read: if isDeveloper() || (isAuthenticated() && resource.data.companyId == get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId);
    }

    // 3. قواعد المستخدمين والمنشآت (Tenant Isolation)
    
    match /global_users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isDeveloper());
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, list: if isDeveloper();
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if isDeveloper() || (isAuthenticated() && get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId);
      
      match /{allSubCollections=**} {
        allow read: if isDeveloper() || (isAuthenticated() && get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId);
        allow write: if isDeveloper() || (isAuthenticated() && get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId && 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN');
      }
    }
  }
}
