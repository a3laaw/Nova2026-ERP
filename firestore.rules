rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة (Sovereign Helpers) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // فحص الانتماء للشركة (مستقر وغير دائري)
    function belongsToCompany(companyId) {
      let userDoc = get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
      return isAuthenticated() && userDoc.companyId == companyId;
    }

    // فحص صلاحية الإدارة (Master Admin Check)
    function isAdmin(companyId) {
      let userDoc = get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
      // نتحقق أولاً من سجل المستخدم العالمي لتجنب Recursion
      let isExplicitAdmin = userDoc.companyId == companyId && (userDoc.roleCode == 'ADMIN' || userDoc.role == 'admin' || userDoc.isDeveloper == true);
      
      // نتحقق من الملكية في حال فشل الدور (للمالكين الجدد)
      // ملاحظة: نسمح بقرءاة وثيقة الشركة للمالك دائماً في قواعد القراءة أدناه
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId)).data;
      let isOwner = companyDoc.ownerUid == request.auth.uid;
      
      return isAuthenticated() && (isOwner || isExplicitAdmin);
    }

    // --- 3. قواعد الهوية العالمية ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      // المالك والمنتمين للشركة يمكنهم القراءة
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || belongsToCompany(companyId));
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid; 
      allow update: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isSovereignDev());

      // حماية خاصة لمجموعة المعدات لضمان عدم تعطل الميدان
      match /equipment/{id} { 
        allow read: if belongsToCompany(companyId) || isAdmin(companyId); 
        allow write: if isAdmin(companyId); 
      }

      // القواعد العامة لباقي المجموعات الفرعية التابعة للشركة
      match /{allAdminCollections=**} {
        allow read: if belongsToCompany(companyId);
        allow write: if isAdmin(companyId);
      }
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }

    // تتبع الحركات العامة
    match /{path=**}/fieldVisits/{id} { allow read: if belongsToCompany(resource.data.companyId); }
    match /{path=**}/attendance/{id} { allow read: if belongsToCompany(resource.data.companyId); }
  }
}