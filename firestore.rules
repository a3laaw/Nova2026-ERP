
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- قانون الأمان الأسمى (Sovereign God Mode) ---
    // منح المطور الرسمي وصولاً مطلقاً وفورياً يتجاوز كافة القيود
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // المفتاح الماستر: يسمح للمطور بالوصول الشامل (قراءة وكتابة) في كافة المستويات
    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- حماية المجموعات المشتركة (Collection Group Rules) ---
    // تبسيط القواعد لضمان عمل الفهارس (Indexes) والتقارير الشاملة بدون أخطاء صلاحيات
    // يسمح بالقراءة لكافة المستخدمين المسجلين لضمان عمل الاستعلامات الشاملة
    match /{path=**}/variations/{voId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/attendance/{attId} {
      allow read: if request.auth != null;
    }

    // --- الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getGlobalUser() {
      let userPath = /databases/$(database)/documents/global_users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data : null;
    }

    function isCompanyActive(cid) {
      let compPath = /databases/$(database)/documents/companies/$(cid);
      return exists(compPath) && get(compPath).data.status == 'active';
    }

    // --- قواعد الهوية والمنشآت (Multi-Tenant Isolation) ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow write: if isSovereignDev() || (isAuthenticated() && request.auth.uid == uid);
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, delete: if isSovereignDev();
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (isSovereignDev() || (getGlobalUser() != null && getGlobalUser().companyId == companyId));
      allow delete: if isSovereignDev();
      
      // قاعدة خاصة للسماح بإنشاء حساب المالك الأول أثناء التسجيل
      match /users/{uid} {
        allow create: if isAuthenticated() && (request.auth.uid == uid);
        allow read, write: if isAuthenticated() && (isSovereignDev() || (request.auth.uid == uid));
      }

      match /{allSubCollections=**} {
        // قفل أمني صارم للمستخدمين العاديين
        allow read: if isAuthenticated() && 
          getGlobalUser() != null &&
          getGlobalUser().companyId == companyId && 
          (isSovereignDev() || (getGlobalUser().isActive == true && isCompanyActive(companyId)));
          
        allow write: if isAuthenticated() && 
          getGlobalUser() != null &&
          getGlobalUser().companyId == companyId && 
          (isSovereignDev() || (getGlobalUser().isActive == true && (getGlobalUser().roleCode == 'ADMIN' || getGlobalUser().role == 'admin')));
      }
    }
  }
}
