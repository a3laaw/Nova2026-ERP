rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة (Sovereign Helpers) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getGlobalUser() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // فحص صلاحية الإدارة (Master Admin Check)
    function isAdmin(companyId) {
      // 1. التحقق من السجل العالمي للمستخدم
      let userDoc = getGlobalUser();
      let isExplicitAdmin = userDoc.companyId == companyId && 
        (userDoc.roleCode == 'ADMIN' || userDoc.role == 'admin' || userDoc.isDeveloper == true);
      
      // 2. التحقق من الملكية المباشرة في وثيقة الشركة (لضمان وصول المالك حتى لو لم يتفعل حسابه بعد)
      let companyDoc = get(/databases/$(database)/documents/companies/$(companyId)).data;
      let isOwner = companyDoc.ownerUid == request.auth.uid;
      
      return isAuthenticated() && (isOwner || isExplicitAdmin);
    }

    // --- 3. قواعد الهوية العالمية ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      // السماح بالقراءة للمالك والموظفين المنتمين للشركة
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || getGlobalUser().companyId == companyId);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid; 
      allow update: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isSovereignDev());

      // حماية سيادية للمعدات: وصول كامل للأدمن والمالك
      match /equipment/{id} { 
        allow read: if isAuthenticated() && getGlobalUser().companyId == companyId; 
        allow write: if isAdmin(companyId); 
      }

      // القواعد العامة لباقي المجموعات الفرعية (الموظفين، المشاريع، الخ)
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && getGlobalUser().companyId == companyId;
        allow write: if isAdmin(companyId);
      }
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSovereignDev());
       allow delete: if isSovereignDev();
    }

    // تتبع الحركات العامة (للمزامنة الميدانية)
    match /{path=**}/fieldVisits/{id} { allow read: if isAuthenticated() && getGlobalUser().companyId == resource.data.companyId; }
    match /{path=**}/attendance/{id} { allow read: if isAuthenticated() && getGlobalUser().companyId == resource.data.companyId; }
  }
}