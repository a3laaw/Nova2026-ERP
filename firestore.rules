
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    // هذا المسار السريع يحل مشكلة permission-denied للمطور فوراً
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // المفتاح الماستر: تجاوز مطلق لكافة القيود للمطور الرسمي
    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- 3. قواعد الهوية العالمية (Global Identity) ---
    // ضروري جداً للسماح للنظام بقراءة بيانات المستخدم ليعرف من هو
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow write: if isSovereignDev() || (isAuthenticated() && request.auth.uid == uid);
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      // السماح بإنشاء المنشأة أثناء التسجيل
      allow create: if isAuthenticated(); 
      
      // حل مشكلة Catch-22: السماح للمستخدم بقراءة بيانات منشأته ليعرف حالتها (نشطة/معلقة)
      allow read: if isAuthenticated() && (
        isSovereignDev() || 
        get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId
      );

      // حماية المجموعات الفرعية (البيانات الحساسة)
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId && 
          (isSovereignDev() || (
            get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.isActive == true &&
            get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active'
          ));
          
        allow write: if isAuthenticated() && 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId && 
          (isSovereignDev() || (
            get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.isActive == true && 
            (get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN' || get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.role == 'admin')
          ));
      }
    }

    // --- 5. طلبات الانضمام ---
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, delete: if isSovereignDev();
    }

    // --- 6. حماية المجموعات المشتركة (Collection Group Rules) ---
    // تبسيط القواعد لضمان عمل الفهارس دون تعقيد الدوال
    match /{path=**}/variations/{voId} { allow read: if isAuthenticated(); }
    match /{path=**}/fieldVisits/{visitId} { allow read: if isAuthenticated(); }
    match /{path=**}/attendance/{attId} { allow read: if isAuthenticated(); }
  }
}
