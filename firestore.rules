
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال السيادية الموحدة ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // وضع المطور (Fast Path) - وصول مطلق لبريد المدير المعتمد
    function isDeveloper() {
      return isAuthenticated() && request.auth.token.email == 'admin@novaflow.com';
    }

    // التحقق من الانتماء للمنشأة (Tenant Isolation)
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // --- قانون الأمان الموحد ---

    // 1. وصول المطور المطلق (God Mode)
    match /{document=**} {
      allow read, write: if isDeveloper();
    }

    // 2. قواعد المستخدمين العاديين (Multi-tenant)
    match /global_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && request.auth.uid == uid;
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if belongsToCompany(companyId);
      
      match /users/{uid} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if isAuthenticated() && request.auth.uid == uid;
      }

      match /employees/{empId} {
        allow read: if belongsToCompany(companyId);
      }

      match /{allSubCollections=**} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId) && 
          (get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN');
      }
    }

    // دعم استعلامات المجموعات (Collection Group) للعملاء
    match /{path=**}/variations/{voId} {
      allow read, list: if isAuthenticated() && belongsToCompany(resource.data.companyId);
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read, list: if isAuthenticated() && belongsToCompany(resource.data.companyId);
    }
  }
}
