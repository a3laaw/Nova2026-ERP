rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. الدوال المساعدة السيادية (Sovereign Helpers) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // الإنفاذ القطعي: الاعتماد حصراً على roleCode الموحد (حروف كبيرة)
    function isGlobalAdmin() {
      let user = get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
      return user.roleCode == 'ADMIN';
    }
    
    function getUserCompany() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId;
    }

    // --- 2. قواعد الهوية العالمية ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isGlobalAdmin());
      // السماح للمستخدم بتحديث بياناته الشخصية (مثل الصورة والاسم)
      allow update: if isAuthenticated() && request.auth.uid == uid;
      // الكتابة الكاملة للمدير فقط
      allow write: if isAuthenticated() && isGlobalAdmin();
    }

    // --- 3. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      allow read: if isAuthenticated() && (getUserCompany() == companyId || isGlobalAdmin());
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && (isGlobalAdmin() || resource.data.ownerUid == request.auth.uid);

      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && (getUserCompany() == companyId || isGlobalAdmin());
        allow write: if isAuthenticated() && (getUserCompany() == companyId && isGlobalAdmin());
      }
    }

    // --- 4. قواعد المجموعات المشتركة (Collection Groups) ---
    // ضرورية للبحث والتقارير الشاملة
    match /{path=**}/jobs/{jobId} {
      allow read: if isAuthenticated() && (getUserCompany() == resource.data.companyId || isGlobalAdmin());
    }
    
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isAuthenticated() && (getUserCompany() == resource.data.companyId || isGlobalAdmin());
      allow write: if isAuthenticated() && (getUserCompany() == resource.data.companyId || isGlobalAdmin());
    }

    match /{path=**}/executions/{execId} {
      allow read, write: if isAuthenticated() && (getUserCompany() == resource.data.companyId || isGlobalAdmin());
    }

    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isGlobalAdmin());
       allow delete: if isGlobalAdmin();
    }
  }
}