
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. قانون الأمان الأسمى (Sovereign Master Key) ---
    function isSovereignDev() {
      return request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // المفتاح الماستر: تجاوز مطلق لكافة القيود للمطور الرسمي
    match /{document=**} {
      allow read, write: if isSovereignDev();
    }

    // --- 2. الدوال المساعدة المحصنة ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // --- 3. قواعد الهوية العالمية (Global Identity) ---
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSovereignDev());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isSovereignDev() || (isAuthenticated() && request.auth.uid == uid);
    }
    
    // --- 4. قواعد المنشآت (Multi-Tenant Core) ---
    match /companies/{companyId} {
      // السماح بإنشاء المنشأة أثناء التسجيل
      allow create: if isAuthenticated(); 
      
      // السماح للمستخدم دائماً بقراءة بيانات منشأته ليعرف حالتها (نشطة/معلقة)
      allow read: if isAuthenticated() && (
        isSovereignDev() || 
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && getUserData().companyId == companyId)
      );

      // --- قواعد المستخدمين داخل الشركة (منفصلة لضمان نجاح التسجيل) ---
      match /users/{uid} {
        allow create: if isAuthenticated() && request.auth.uid == uid;
        allow read: if isAuthenticated() && (isSovereignDev() || getUserData().companyId == companyId);
        allow update: if isAuthenticated() && (isSovereignDev() || (getUserData().companyId == companyId && (getUserData().roleCode == 'ADMIN' || request.auth.uid == uid)));
      }

      // حماية المجموعات الفرعية التشغيلية
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && 
          getUserData().companyId == companyId && 
          (isSovereignDev() || (
            getUserData().isActive == true &&
            get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active'
          ));
          
        allow write: if isAuthenticated() && 
          getUserData().companyId == companyId && 
          (isSovereignDev() || (
            getUserData().isActive == true && 
            (getUserData().roleCode == 'ADMIN' || getUserData().role == 'admin')
          ));
      }
    }

    // --- 5. طلبات الانضمام ---
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, delete: if isSovereignDev();
    }

    // --- 6. حماية المجموعات المشتركة (Collection Group Rules) ---
    match /{path=**}/variations/{voId} { allow read: if isAuthenticated(); }
    match /{path=**}/fieldVisits/{visitId} { allow read: if isAuthenticated(); }
    match /{path=**}/attendance/{attId} { allow read: if isAuthenticated(); }
  }
}
