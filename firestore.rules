
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- الدوال المساعدة السيادية المحدثة للسرعة والأمان ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // التحقق من هوية المطور (Master Key)
    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@novaflow.com' ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.isDeveloper == true)
      );
    }

    // التحقق من انتساب الموظف للمنشأة (عزل البيانات)
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId)
      );
    }

    // التحقق من الصلاحيات الإدارية داخل المنشأة
    function isAdmin(companyId) {
      return isAuthenticated() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/global_users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.companyId == companyId && 
         (get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.roleCode == 'ADMIN' || 
          get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    // --- سجلات المستخدمين العالمية (Identity) ---
    
    match /global_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isDeveloper());
      allow list: if isDeveloper();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isDeveloper() || (isAuthenticated() && request.auth.uid == uid);
      allow delete: if isDeveloper();
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, list, write: if isDeveloper();
    }

    // --- سجلات المنشأة (Multi-tenant) ---
    
    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if isDeveloper() || belongsToCompany(companyId);
      allow update: if isDeveloper() || isAdmin(companyId);
      allow delete: if isDeveloper();
      
      match /users/{uid} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow create, update: if isAuthenticated() && (request.auth.uid == uid || isAdmin(companyId));
        allow delete: if isAdmin(companyId) || isDeveloper();
      }

      match /employees/{empId} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow write: if isAdmin(companyId) || isDeveloper();
      }

      match /{allSubCollections=**} {
        allow read: if belongsToCompany(companyId) || isDeveloper();
        allow write: if isAdmin(companyId) || isDeveloper();
      }
    }

    // دعم استعلامات الـ Collection Group (يجب أن تتوافق مع فلاتر الاستعلام)
    match /{path=**}/variations/{voId} {
      allow read, list: if isAuthenticated() && (isDeveloper() || belongsToCompany(resource.data.companyId));
    }

    match /{path=**}/fieldVisits/{visitId} {
      allow read, list: if isAuthenticated() && (isDeveloper() || belongsToCompany(resource.data.companyId));
    }
  }
}
