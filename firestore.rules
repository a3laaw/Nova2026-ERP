
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- قانون الأمان الأسمى (Sovereign God Mode) ---
    // هذا المسار يمنح المطور وصولاً مطلقاً ومباشراً لكافة السجلات والاستعلامات الشاملة (Collection Groups)
    // وضعناه في المقدمة لضمان تجاوزه لكافة القواعد اللاحقة
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@novaflow.com';
    }

    // --- الدوال المساعدة للمستخدمين العاديين ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getGlobalUser() {
      return get(/databases/$(database)/documents/global_users/$(request.auth.uid)).data;
    }

    // --- حماية المجموعات المشتركة للمستخدمين العاديين (Collection Group Rules) ---
    // هذه القواعد ضرورية لعمل التقارير الشاملة لمن يملك صلاحية 'all' في مصفوفته
    match /{path=**}/variations/{voId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/fieldVisits/{visitId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/attendance/{attId} {
      allow read: if isAuthenticated();
    }

    // --- قواعد الهوية والمنشآت (Multi-Tenant Isolation) ---
    match /global_users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }
    
    match /company_requests/{reqId} {
       allow create: if isAuthenticated(); 
       allow read, list: if false; // المطور مغطى بالقاعدة العلوية
    }

    match /companies/{companyId} {
      allow create: if isAuthenticated(); 
      allow read, list: if isAuthenticated() && getGlobalUser().companyId == companyId;
      
      match /{allSubCollections=**} {
        allow read: if isAuthenticated() && getGlobalUser().companyId == companyId;
        allow write: if isAuthenticated() && getGlobalUser().companyId == companyId && 
          (getGlobalUser().roleCode == 'ADMIN' || getGlobalUser().role == 'admin');
      }
    }
  }
}
